{
  "expo": {
    "name": "Field Kit",
    "slug": "field-kit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fieldkit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.colouringcode.fieldkit",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.colouringcode.fieldkit",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Field Kit uses your location only to sort defibrillators by distance. Your position is never stored and never sent anywhere."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
