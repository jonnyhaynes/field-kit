# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders (expo prebuild / CNG)
/ios
/android

# agent tooling -- personal permission overrides, not shared policy.
# The committed policy lives in .commandcode/settings.json and .claude/settings.json.
.commandcode/settings.local.json
.claude/settings.local.json

# Raw OpenStreetMap extracts. Large, and reproducible from the pinned URL and md5
# recorded in docs/plans/fieldkit-v1.md. Only the derived assets/data/aed.db ships.
*.osm.pbf
*.osm.pbf.md5
*.osm

# Cut region packs, where `npm run build:pack` writes by default. Release assets, not repository
# content: a 19 MB binary would be paid for on every clone and every CI run. What ships is the
# catalogue that points at it -- assets/maps/regions.json -- so this is deliberately ignored and
# the bundled archive deliberately is not.
/packs/

# The font pipeline's virtualenv (see scripts/build-fonts.sh). Tooling, not source, and a venv in
# the tree would otherwise be committed wholesale.
/.venv-fonts/
